# VAW Pay — configuration
# Copy to .env (or run `npm run setup`). Every secret below is OPTIONAL: when unset, a random
# value is generated once and stored in data/.secrets/ (mode 0600). Back that folder up with the
# database; losing it makes encrypted webhook secrets and device logins unreadable.

# --- Runtime mode ----------------------------------------------------------
# Production (default) needs a public domain. For local work set both of these:
VAWPAY_MODE=localhost
VAWPAY_ALLOW_LOCALHOST_MODE=true
# Production: the domain served through Cloudflare Tunnel / your reverse proxy, e.g. vawtech.in
# (checkout is then served at https://<DEPLOYMENT_PREFIX>.<CLOUDFLARE_DOMAIN>)
# CLOUDFLARE_DOMAIN=vawtech.in
# DEPLOYMENT_PREFIX=pay
# Interface the services bind to (default: 127.0.0.1). Use 0.0.0.0 inside Docker only.
# VAWPAY_BIND_HOST=127.0.0.1

# --- Ports -------------------------------------------------------------------
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_STORE_PORT=5000

BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000

# --- Database ----------------------------------------------------------------
# SQLite file (Node's built-in node:sqlite, WAL mode). Relative paths resolve from this folder.
SQLITE_DB_PATH=./data/vawpay.sqlite

# --- Secrets (optional, see note at the top) -----------------------------------
# ADMIN_API_TOKEN=            # token you paste into the Merchant Admin login
# OBSERVER_API_TOKEN=         # shared by the Gmail / SMS observers
# ENCRYPTION_MASTER_KEY=      # 64 hex chars (32 bytes) — NOT a passphrase
# ANDROID_ENROLLMENT_SECRET=
# INTERNAL_SERVICE_TOKEN=
# DEVICE_CREDENTIAL_KEY=
# BLIND_INDEX_KEY=

# --- Payment timing ------------------------------------------------------------
PAYMENT_ACTIVE_WINDOW_MS=300000        # time to pay (5 min)
PAYMENT_PROCESSING_WINDOW_MS=30000     # verification window after "I have paid" (30 s)

# --- Gmail observer (optional) -------------------------------------------------
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:6003/oauth/callback
# GMAIL_POLL_INTERVAL_MS=5000

# --- SMS (Google Messages web) observer (optional) -----------------------------
# SMS_OBSERVER_POLL_INTERVAL_MS=3000

# --- Webhooks ------------------------------------------------------------------
WEBHOOK_MAX_RETRIES=5
# Allow webhooks to private/LAN addresses (leave false in production):
# VAWPAY_ALLOW_PRIVATE_WEBHOOKS=false

# --- Checkout framing ------------------------------------------------------------
# Origins allowed to embed the checkout in an iframe (comma/space separated, bare origins only).
# Unset = 'self' in production. The VAW website is added by `npm run setup`.
# CHECKOUT_FRAME_ANCESTORS=https://vawtech.in https://www.vawtech.in
